# Copy this file to .env.local and fill in.
# .env.local is git-ignored. Never put real values in this example file.

# ── Supabase ────────────────────────────────────────────────────────────
# Create a project at https://app.supabase.com, then copy these from
# Project Settings → API. The anon key is safe to expose to the browser; the
# service role key is server-only: never import it into a client component.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ───────────────────────────────────────────────────────────
# Paste parser, spreadsheet column mapping, leak insights, weekly report.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
# Verified sender for mail that goes to users (nudges, weekly report).
# Falls back to SIGNUP_NOTIFY_FROM when empty.
USER_NUDGE_FROM=
# Optional Reply-To on user mail.
USER_NUDGE_REPLY_TO=
# "Someone just signed up" alert: verified sender and the inbox it goes to.
SIGNUP_NOTIFY_FROM=
SIGNUP_NOTIFY_TO=
# Long random string. Signs the unsubscribe links. The cron jobs refuse to
# send anything while this is empty.
EMAIL_UNSUBSCRIBE_SECRET=
# Public site URL used in email links. Defaults to https://amiup.io.
AMIUP_URL=

# ── Shared secrets ──────────────────────────────────────────────────────
# Sent as the x-cron-secret header by whatever schedules the cron endpoints.
CRON_SECRET=
# Sent as the x-signup-webhook-secret header by the Supabase database webhook.
SIGNUP_WEBHOOK_SECRET=

# ── Admin ───────────────────────────────────────────────────────────────
# Comma-separated emails allowed to open /admin. NEXT_PUBLIC_ values are
# built into the browser bundle, so anyone can read this list.
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Optional switches ───────────────────────────────────────────────────
# Set to 1 to make a cron run count who it would email without sending.
CRON_DRIP_DRY_RUN=
CRON_WEEKLY_DRY_RUN=
